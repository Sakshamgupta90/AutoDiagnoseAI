# Frontend: build the Vue app, then serve it with Caddy (which also proxies /api to the backend and handles HTTPS).
FROM node:22-alpine AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Same-origin API: the browser calls https://<DOMAIN>/api/v1, so no CORS is involved.
ENV VITE_API_BASE_URL=/api/v1 \
    VITE_USE_MOCK=false \
    VITE_HEALTH_PATH=/health
RUN npm run build

FROM caddy:2
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
