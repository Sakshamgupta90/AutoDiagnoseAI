# Base URL of the FastAPI backend (no trailing slash), e.g. https://api.autodiagnose.example
# Leave empty to run the UI against the built-in mock backend.
VITE_API_BASE_URL=

# Force the mock backend even when VITE_API_BASE_URL is set ("true" / "false").
VITE_USE_MOCK=true

# Health-check path used for the connection indicator in the header.
VITE_HEALTH_PATH=/health

# Currency used for parts/labour estimates.
VITE_CURRENCY=SGD
