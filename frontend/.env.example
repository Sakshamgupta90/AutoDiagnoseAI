# Backend API base URL (no trailing slash). Production uses the same origin: /api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true = use the built-in mock backend (no server required)
VITE_USE_MOCK=false

# Health-check path used for the connection indicator
VITE_HEALTH_PATH=/health

# Currency for parts and labour estimates
VITE_CURRENCY=SGD
