# AutoDiagnose AI backend configuration.
# Copy to `.env` and fill in the secrets. `.env` is git-ignored; never commit it.

# ---- Amazon Bedrock (Claude Sonnet 4.5) ----
AWS_REGION=ap-southeast-1
# Option A: IAM access keys (session token only for temporary credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Option B: a Bedrock API key (bearer token) instead of access keys
AWS_BEARER_TOKEN_BEDROCK=
# Global cross-region inference profile (Sonnet 4.5 has no apac. profile)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# false = no cloud calls; answers come from the local knowledge-base fallback
LLM_ENABLED=true
LLM_MAX_TOKENS=2048

# ---- Cost controls ----
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0
DAILY_BUDGET_USD=5.0

# ---- Agent budget ----
MAX_TURNS=3
MAX_TOOL_CALLS=6
JOB_TIME_BUDGET_SECONDS=45
CONFIDENCE_THRESHOLD=0.5

# ---- Knowledge base ----
RELEVANCE_THRESHOLD=0.40
SEARCH_TOP_K=5

# ---- API ----
# Browser origins allowed to call the API. Production serves the UI on the same origin,
# so this is only needed for local development.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=12
NHTSA_ENABLED=true

# ---- Production (Lightsail) ----
# Public hostname for HTTPS. Without a domain, use sslip.io, e.g. 13.229.10.20 -> 13-229-10-20.sslip.io
DOMAIN=
